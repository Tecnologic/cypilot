# Copy to .env (git-ignored); VS Code loads it for launch configs and the terminal.
# CAN interface text, see README (socketcan:vcan0, canable:/dev/ttyACM0, udp:127.0.0.1)
CYPILOT_IFACE=socketcan:vcan0
# PIN for the web login (generated when listening beyond localhost)
#CYPILOT_PIN=1234
# Local UNIMOC checkout (west workspace) instead of downloading the DSDL
#CYPILOT_UNIMOC=/home/alex/zephyr-ws/unimoc
# native_sim binary for tests/sim
#CYPILOT_SIM_EXE=
# Where runs are recorded
#CYPILOT_RUNS=
